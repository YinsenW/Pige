{
  "schemaVersion": 1,
  "id": "anydoc@0.1.7",
  "engine": "anydoc",
  "engineVersion": "0.1.7",
  "sourceKinds": ["pdf_file"],
  "capabilities": ["semantic_markdown", "document_metadata", "page_locators_bridge", "ocr_handoff"],
  "executionBoundary": "node_worker_thread",
  "networkAccess": false,
  "hiddenDownloads": false,
  "limits": {
    "maxBytes": 209715200,
    "maxPages": 2000,
    "timeoutMs": 60000
  }
}
