    "environmentRequirements": {
      "DISABLE_TELEMETRY": "1",
      "DO_NOT_TRACK": "1",
      "controlledHomeAndConfigRoots": true,
      "sanitizedPathWithResolvedDescendants": true,
      "explicitNpmRegistryPrefixCacheAndConfig": true,
      "ambientNpmConfigAllowed": false,
      "ambientUserHomeDestinationsAllowed": false,
      "dynamicAgentDetectionAfterConfirmation": false,
      "crossOriginSkillArtifacts": "reject_unless_exact_origin_and_digest_were_reviewed"
