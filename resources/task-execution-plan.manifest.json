      { "ordinal": 5, "actionId": "auth_login", "interactionProtocol": "browser_oauth", "destinationKinds": ["tool_private_config"] },
      { "ordinal": 6, "actionId": "auth_status", "interactionProtocol": "none", "destinationKinds": [], "readOnlyProbe": true }
