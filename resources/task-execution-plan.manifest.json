  "officialRecipeFixture": {
    "recipeId": "official.feishu-cli.install-config-auth-status",
    "recipeVersion": "1",
    "displayName": "Feishu CLI",
    "attachmentTurnEligibility": "explicit_user_authored_ambient_task_only",
    "attachmentPresenceOrFallbackGrantsAuthority": false,
    "movingSelectorsMustResolveBeforeConfirmation": true,
    "sources": [
      {
        "id": "feishu-cli-package",
        "kind": "npm_package",
        "identity": "@larksuite/cli",
        "selector": "latest",
        "declaredOrigin": "https://registry.npmjs.org",
        "binaryOriginPolicy": "github_release_only_no_custom_registry_or_mirror_fallback",
        "requiredResolution": [
          "exactVersion",
          "tarballUrl",
          "tarballSri",
          "platformBinaryUrl",
          "platformBinarySha256",
          "redirectOrigins"
        ]
      },
      {
        "id": "skills-installer-package",
        "kind": "npm_package",
        "identity": "skills",
        "selector": "latest",
        "declaredOrigin": "https://registry.npmjs.org",
        "requiredResolution": ["exactVersion", "tarballUrl", "tarballSri"]
      },
      {
        "id": "feishu-cli-skill",
        "kind": "official_well_known_skill_index",
        "identity": "https://open.feishu.cn/.well-known/skills/index.json",
        "selector": "current_response",
        "declaredOrigin": "https://open.feishu.cn",
        "requiredResolution": [
          "indexDigest",
          "selectedSkillIds",
          "selectedFileSet",
          "perFileDigests",
          "targetAgentSet",
          "destinationRoots",
          "copyOrSymlinkMode",
          "overwriteSet"
        ],
        "frozenSelection": {
          "indexSha256": "babfb26a9ef45d06c95955d92fca17056a526a8f524db93b62fb6accf9fa95ba",
          "skillCount": 27,
