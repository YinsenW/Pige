    "browserOAuthProfiles": {
      "allowedAccountOrigins": [
        "https://accounts.feishu.cn",
        "https://accounts.larksuite.com"
      ],
      "config_init": "bounded_streaming_process_session",
      "auth_login": "device_flow_no_wait_json_then_private_device_code_poll",
      "deviceCodeProjection": "main_private_ephemeral_only",
      "restartPolicy": "adopt_exact_interaction_or_fail_without_minting_replacement"
    },
    "skillInstallProjection": {
      "opaqueNpxStepAllowed": false,
      "allDiscoveredSkillsAllowed": false,
      "requiredBeforeConfirmation": [
        "exactSkillsPackageIdentity",
        "exactFrozenSkillIds",
        "completeFileSetAndPerFileDigests",
        "canonicalWorkingDirectory",
        "targetAgentSet",
        "destinationRoots",
        "copyOrSymlinkMode",
        "overwriteAndConflictPolicy"
      ],
      "driftPolicy": "fail_before_network_or_write"
